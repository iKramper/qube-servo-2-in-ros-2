* { font-family:"Inter","Segoe UI",sans-serif; font-size:12px; }
QMainWindow,QDialog,QWidget{background:#02070A;color:#D8F7FF;} QFrame#panel{background:#051A21;border:1px solid rgba(0,230,255,120);border-radius:8px;} QFrame#subPanel{background:#031218;border:1px solid rgba(0,230,255,55);border-radius:6px;} QFrame#chartFrame{background:#00080C;border:1px solid rgba(0,230,255,50);border-radius:6px;}
QLabel#title{color:#9DEEFF;font-size:17px;font-weight:700;} QLabel#panelTitle,QLabel#chartTitle{color:#54DFF1;font-weight:700;} QLabel#metricValue{color:#D8F7FF;font-family:"DejaVu Sans Mono";font-weight:700;background:#05202A;border:1px solid #15505F;border-radius:4px;padding:2px 6px;} QLabel#subtitle,QLabel#fieldLabel{color:#76AEBB;} QLabel#errorText{color:#FF6B82;}
QPushButton{background:#07313B;color:#D8F7FF;border:1px solid #00A9BC;border-radius:6px;padding:6px 12px;font-weight:650;} QPushButton#secondary{background:transparent;border-color:#76639A;} QPushButton#danger{background:#5B1824;border-color:#FF4D6D;color:#FFF;} QPushButton#recordButton{background:#FFD166;color:#081014;border-color:#D9A928;} QPushButton[recording="true"]{background:#FF4D6D;color:#FFF;}
QLineEdit,QComboBox,QSpinBox,QDoubleSpinBox,QTextEdit{background:#000A0F;color:#D8F7FF;border:1px solid #15505F;border-radius:5px;padding:4px 7px;} QStatusBar{background:#01090C;color:#76AEBB;border-top:1px solid #15505F;}
