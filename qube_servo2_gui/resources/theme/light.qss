* { font-family:"Inter","Segoe UI","DejaVu Sans",sans-serif; font-size:13px; }
QMainWindow,QDialog,QWidget { background:#F8FAFC; color:#0F172A; }
QFrame#panel,QFrame#chartFrame,QFrame#valueTile { background:#FFFFFF; border:2px solid #CBD5E1; border-radius:10px; }
QFrame#subPanel { background:#F8FAFC; border:1px solid #CBD5E1; border-radius:6px; }
QLabel#title,QLabel#panelTitle,QLabel#chartTitle { color:#3B82F6; font-weight:700; }
QLabel#title { font-size:18px; } QLabel#metricValue { color:#1D4ED8; font-weight:700; padding:2px 6px; background:#EFF6FF; border-radius:4px; }
QLabel#subtitle,QLabel#fieldLabel,QLabel#chartWindowLabel { color:#64748B; }
QLabel#errorText { color:#DC2626; }
QPushButton { background:#3B82F6; color:#FFF; border:1px solid #2563EB; border-radius:6px; padding:6px 12px; font-weight:650; }
QPushButton#secondary { background:#FFF; color:#0F172A; border-color:#CBD5E1; } QPushButton#danger { background:#DC2626; border-color:#B91C1C; color:#FFF; }
QPushButton#recordButton { background:#F4B400; color:#111827; border:1px solid #D99A00; } QPushButton[recording="true"] { background:#DC2626; color:#FFF; }
QLineEdit,QComboBox,QSpinBox,QDoubleSpinBox,QTextEdit { background:#FFF; color:#0F172A; border:1px solid #CBD5E1; border-radius:5px; padding:5px 7px; }
QStatusBar { background:#FFF; color:#334155; border-top:1px solid #CBD5E1; }
