* { font-family:"Inter","Segoe UI",sans-serif; font-size:13px; }
QMainWindow,QDialog,QWidget { background:#050510; color:#EAF2FF; }
QFrame#panel,QFrame#chartFrame,QFrame#valueTile { background:#0B0B18; border:1px solid #522A78; border-radius:10px; }
QFrame#subPanel{background:#090916;border:1px solid #34205A;border-radius:6px;}
QLabel#title,QLabel#panelTitle,QLabel#chartTitle{color:#FF2BD6;font-weight:700;} QLabel#title{font-size:18px;}
QLabel#metricValue{color:#00F5FF;font-weight:700;padding:2px 6px;background:#10102A;border-radius:4px;} QLabel#subtitle,QLabel#fieldLabel{color:#8AA0C8;} QLabel#errorText{color:#FF3158;}
QPushButton{background:#FF2BD6;color:#050510;border:1px solid #FF2BD6;border-radius:6px;padding:6px 12px;font-weight:700;} QPushButton#secondary{background:transparent;color:#EAF2FF;border-color:#522A78;} QPushButton#danger{background:#FF3158;color:#FFF;border-color:#FF3158;}
QPushButton#recordButton{background:#FFE66D;color:#090916;border-color:#D4B300;} QPushButton[recording="true"]{background:#FF3158;color:#FFF;}
QLineEdit,QComboBox,QSpinBox,QDoubleSpinBox,QTextEdit{background:#090916;color:#EAF2FF;border:1px solid #522A78;border-radius:5px;padding:5px 7px;} QStatusBar{background:#0B0B18;color:#8AA0C8;border-top:1px solid #34205A;}
