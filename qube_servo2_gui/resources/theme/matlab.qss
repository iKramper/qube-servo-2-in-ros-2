/* MATLAB / laboratory presentation theme */
* { font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif; font-size: 12px; }
QMainWindow, QDialog, QWidget { background:#ECECEC; color:#1A1A1A; }
QFrame#panel { background:#F8F8F8; border:1px solid #C9C9C9; border-radius:4px; }
QFrame#subPanel { background:#F1F1F1; border:1px solid #D3D3D3; border-radius:3px; }
QFrame#chartFrame { background:#FFFFFF; border:1px solid #D0D0D0; border-radius:3px; }
QChartView#scopeChartView { background:transparent; border:none; }
QLabel#title { color:#0072BD; font-size:17px; font-weight:700; letter-spacing:.5px; }
QLabel#panelTitle, QLabel#chartTitle { color:#345B78; font-size:14px; font-weight:700; }
QLabel#metricValue { color:#005A9E; font-size:13px; font-family:"DejaVu Sans Mono",Consolas,monospace; font-weight:700; padding:2px 6px; background:#EDF5FA; border:1px solid #D6E7F2; border-radius:3px; }
QLabel#fieldLabel, QLabel#subtitle, QLabel#chartWindowLabel { color:#626262; }
QLabel#errorText { color:#B3261E; }
QPushButton { background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #FAFAFA,stop:1 #E7E7E7); color:#111; border:1px solid #A8A8A8; border-radius:3px; padding:5px 11px; font-weight:600; }
QPushButton:hover { background:#E7F2FA; border-color:#0072BD; }
QPushButton#secondary { background:#F4F4F4; color:#333; }
QPushButton#danger { background:#B3261E; border-color:#8E1C17; color:#FFF; }
QPushButton:disabled { color:#999; background:#E3E3E3; }
QPushButton[recording="true"] { background:#B3261E; border-color:#8E1C17; color:#FFF; }
QPushButton#recordButton { background:#F4B400; color:#151515; border:1px solid #E5A100; font-weight:750; padding:6px 13px; }
QPushButton#recordButton[recording="true"] { background:#B3261E; color:#FFF; border-color:#B3261E; }
QToolButton#chartToolButton { background:#F5F5F5; color:#444; border:1px solid #C3C3C3; border-radius:2px; padding:2px 5px; font-weight:600; }
QLineEdit,QComboBox,QSpinBox,QDoubleSpinBox,QTextEdit { background:#FFF; color:#111; border:1px solid #B6B6B6; border-radius:2px; padding:4px 6px; selection-background-color:#0072BD; selection-color:#FFF; }
QLineEdit:focus,QComboBox:focus,QSpinBox:focus,QDoubleSpinBox:focus,QTextEdit:focus { border:1px solid #0072BD; }
QCheckBox { spacing:5px; }
QToolTip { background:#FFFFE1; color:#111; border:1px solid #777; padding:4px; }
QStatusBar { background:#F5F5F5; color:#444; border-top:1px solid #C8C8C8; }
