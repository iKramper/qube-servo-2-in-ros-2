* { font-family:"Inter","Segoe UI","DejaVu Sans",sans-serif; font-size:13px; }
QMainWindow,QDialog,QWidget { background:#0A0E1A; color:#E2E8F0; }
QFrame#panel,QFrame#chartFrame,QFrame#valueTile { background:#141B2E; border:1px solid #2D3748; border-radius:10px; }
QFrame#subPanel { background:#0F1420; border:1px solid #2D3748; border-radius:6px; }
QLabel#title,QLabel#panelTitle,QLabel#chartTitle { color:#60A5FA; font-weight:700; } QLabel#title{font-size:18px;}
QLabel#metricValue { color:#93C5FD; font-weight:700; padding:2px 6px; background:#111827; border-radius:4px; }
QLabel#subtitle,QLabel#fieldLabel,QLabel#chartWindowLabel { color:#94A3B8; } QLabel#errorText{color:#F87171;}
QPushButton { background:#60A5FA; color:#08111F; border:1px solid #60A5FA; border-radius:6px; padding:6px 12px; font-weight:650; }
QPushButton#secondary { background:transparent; color:#E2E8F0; border-color:#475569; } QPushButton#danger{background:#EF4444;color:#FFF;border-color:#EF4444;}
QPushButton#recordButton{background:#F2C14E;color:#10141D;border-color:#D6A526;} QPushButton[recording="true"]{background:#DC4C5A;color:#FFF;}
QLineEdit,QComboBox,QSpinBox,QDoubleSpinBox,QTextEdit { background:#0F1420; color:#E2E8F0; border:1px solid #334155; border-radius:5px; padding:5px 7px; }
QStatusBar{background:#141B2E;color:#CBD5E1;border-top:1px solid #2D3748;}
