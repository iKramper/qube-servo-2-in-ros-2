* {
  font-family: "Inter", "Segoe UI", "DejaVu Sans", sans-serif;
  font-size: 13px;
}
QMainWindow, QWidget { background: #F8FAFC; color: #0F172A; }
QFrame#panel, QFrame#chartFrame, QFrame#valueTile {
  background: #FFFFFF; border: 2px solid #CBD5E1; border-radius: 12px; padding: 10px;
}
QLabel#title, QLabel#panelTitle, QLabel#chartTitle {
  font-size: 18px; font-weight: 700; color: #3B82F6; text-transform: uppercase; letter-spacing: 1px;
}
QLabel#valueTileLabel { font-weight: 600; color: #64748B; text-transform: uppercase; letter-spacing: 0.5px; }
QLabel#valueTileValue { font-size: 28px; font-weight: 700; color: #3B82F6; }
QLabel#valueTileUnit, QLabel#subtitle { color: #64748B; }
QPushButton {
  background: #3B82F6; border: 2px solid #3B82F6; border-radius: 10px; padding: 9px 15px;
  color: #F8FAFC; font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px;
}
QPushButton:hover { border-color: #10B981; }
QPushButton#secondary { background: transparent; border-color: #CBD5E1; color: #0F172A; }
QPushButton#danger { background: #DC2626; border-color: #DC2626; color: #FFFFFF; font-weight: 800; }
QPushButton:disabled { background: #CBD5E1; border-color: #CBD5E1; color: #64748B; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit {
  background: #FFFFFF; border: 2px solid #CBD5E1; border-radius: 8px; padding: 7px 10px; color: #0F172A;
  selection-background-color: #3B82F6;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus { border-color: #3B82F6; }
QCheckBox { spacing: 7px; color: #0F172A; }
QGroupBox { border: 1px solid #CBD5E1; border-radius: 10px; margin-top: 12px; padding-top: 12px; font-weight: 700; color: #3B82F6; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; }
QToolTip { background: #FFFFFF; color: #0F172A; border: 1px solid #3B82F6; padding: 6px; }
QScrollArea { border: none; }
QScrollBar:vertical { background: #FFFFFF; width: 12px; border: none; }
QScrollBar::handle:vertical { background: #CBD5E1; border-radius: 6px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #3B82F6; }
QStatusBar { background: #FFFFFF; color: #0F172A; border-top: 1px solid #CBD5E1; }
QTabBar::tab { background: transparent; color: #64748B; padding: 10px 18px; font-weight: 600; border: none; }
QTabBar::tab:hover { color: #3B82F6; }
QTabBar::tab:selected { color: #3B82F6; border-bottom: 3px solid #3B82F6; }


/* Compact HMI widgets */
QFrame#subPanel { padding: 4px; }
QLabel#metricValue { font-size: 13px; font-weight: 700; padding: 2px 6px; }
QLabel#fieldLabel { font-weight: 600; }
QLabel#chartWindowLabel { padding: 0 3px; }
QToolButton#chartToolButton { min-width: 24px; min-height: 20px; }
QPushButton[recording="true"] { font-weight: 700; }
QChartView#scopeChartView { border: none; }

/* Data recorder state button */
QPushButton#recordButton {
  background: #F4B400; color: #111827; border: 1px solid #D99A00;
  font-weight: 750; padding: 6px 13px;
}
QPushButton#recordButton:hover { background: #F4B400; border: 2px solid #D99A00; }
QPushButton#recordButton[recording="true"] {
  background: #DC2626; color: #FFFFFF; border-color: #DC2626;
}
