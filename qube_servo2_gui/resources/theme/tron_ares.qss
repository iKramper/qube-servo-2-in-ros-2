/* ============================================================================
 * TRON ARES / QUBE-Servo 2
 * Red tactical instrumentation, blue telemetry accents, restrained glow.
 * The style deliberately uses hierarchy rather than giving every widget the
 * same font size/weight. Custom HUD panels and manual instruments are painted
 * in C++ and inherit the palette defined by this theme.
 * ========================================================================== */

* {
  font-family: "Inter", "Segoe UI", "DejaVu Sans", sans-serif;
  font-size: 11px;
}

QMainWindow, QDialog, QWidget {
  background: #030508;
  color: #E8EEF4;
}

QMainWindow {
  background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
              stop:0 #020306, stop:0.56 #05070A, stop:1 #090609);
}

/* ----- Page hierarchy ---------------------------------------------------- */
QLabel#eyebrow {
  color: #6F879D;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.6px;
}

QLabel#pageTitle {
  color: #FF5468;
  font-size: 22px;
  font-weight: 900;
  letter-spacing: 1.3px;
}

QLabel#pageSubtitle, QLabel#subtitle {
  color: #74899D;
  font-size: 10px;
}

QLabel#title {
  color: #FF5468;
  font-size: 18px;
  font-weight: 850;
  letter-spacing: 1.0px;
}

QLabel#panelTitle, QLabel#chartTitle {
  color: #69B5F0;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.9px;
}

/* ----- HUD surfaces ------------------------------------------------------ */
QFrame#hudPanel {
  background: transparent;
  border: none;
}

QFrame#panel {
  background: rgba(7, 10, 15, 235);
  border: 1px solid rgba(255, 60, 80, 100);
  border-radius: 6px;
}

QFrame#subPanel {
  background: rgba(15, 12, 17, 220);
  border: 1px solid rgba(255, 60, 80, 50);
  border-radius: 5px;
}

QFrame#hudSeparator {
  color: rgba(255, 65, 82, 65);
  background: rgba(255, 65, 82, 42);
  max-height: 1px;
}

/* ----- Metric capsules -------------------------------------------------- */
QLabel#metricValue,
QLabel#controllerStateReadout,
QLabel#sourceReadout,
QLabel#sourceStatusMetric {
  color: #F5F8FB;
  font-family: "DejaVu Sans Mono", "Consolas", monospace;
  font-weight: 750;
  background: rgba(7, 22, 34, 235);
  border: 1px solid rgba(72, 151, 212, 110);
  border-radius: 4px;
  padding: 3px 8px;
}

QLabel#controllerStateReadout {
  color: #FFE2E6;
  border-color: rgba(255, 73, 94, 115);
  background: rgba(44, 10, 16, 220);
  font-size: 11px;
}

QLabel#sourceReadout, QLabel#sourceStatusMetric {
  color: #A9D9FF;
  font-size: 10px;
}

QLabel#manualValueReadout {
  color: #FFFFFF;
  font-family: "DejaVu Sans Mono", "Consolas", monospace;
  font-size: 17px;
  font-weight: 900;
  background: rgba(55, 9, 17, 230);
  border: 1px solid #D92E46;
  border-radius: 4px;
  padding: 5px 12px;
}

QLabel#manualInstrumentTitle {
  color: #FF6A7D;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 1.6px;
}

QLabel#instrumentScale, QLabel#scopeHint {
  color: #607B93;
  font-family: "DejaVu Sans Mono", monospace;
  font-size: 9px;
}

QLabel#systemStatusValue {
  color: #FF667A;
  font-family: "DejaVu Sans Mono", monospace;
  font-size: 15px;
  font-weight: 900;
  background: rgba(48, 10, 16, 220);
  border: 1px solid rgba(255, 63, 84, 140);
  padding: 6px 10px;
  border-radius: 4px;
}

QLabel#systemStatusValue[connected="true"] {
  color: #BCE8FF;
  background: rgba(8, 31, 48, 230);
  border-color: rgba(80, 174, 236, 160);
}

QLabel#systemPathValue {
  color: #DCE8F2;
  font-family: "DejaVu Sans Mono", monospace;
  font-size: 11px;
  background: rgba(4, 11, 17, 190);
  border-left: 2px solid rgba(73, 155, 216, 130);
  padding: 5px 8px;
}

QLabel#systemMetricLarge {
  color: #FFFFFF;
  font-family: "DejaVu Sans Mono", monospace;
  font-size: 20px;
  font-weight: 900;
  background: rgba(7, 19, 29, 230);
  border: 1px solid rgba(73, 155, 216, 120);
  padding: 7px 12px;
  border-radius: 4px;
}

/* ----- Inputs ------------------------------------------------------------ */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit {
  background: #070D13;
  color: #E7EDF2;
  border: 1px solid #233848;
  border-radius: 4px;
  padding: 5px 8px;
  selection-background-color: #B81931;
  selection-color: #FFFFFF;
}

QComboBox#controllerSelector, QComboBox#modeSelector {
  min-height: 28px;
  color: #F4F8FC;
  font-weight: 750;
  background: rgba(8, 18, 27, 240);
  border: 1px solid rgba(69, 144, 201, 130);
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus {
  border-color: #FF435B;
}

QComboBox::drop-down {
  border: none;
  width: 22px;
}

QComboBox QAbstractItemView {
  background: #080D12;
  color: #E7EDF2;
  border: 1px solid #9E2539;
  selection-background-color: #55111E;
  selection-color: #FFFFFF;
  outline: none;
}

QCheckBox {
  spacing: 7px;
  color: #B9C7D3;
  font-size: 10px;
  font-weight: 650;
}

QCheckBox#armSwitch {
  color: #FFB3BE;
  font-weight: 850;
  letter-spacing: 0.6px;
}

QCheckBox::indicator {
  width: 15px;
  height: 15px;
  border: 1px solid #3B5265;
  background: #060B10;
  border-radius: 2px;
}

QCheckBox::indicator:checked {
  background: #C8243D;
  border-color: #FF5368;
}

/* ----- Buttons ----------------------------------------------------------- */
QPushButton {
  background: rgba(10, 28, 42, 235);
  color: #ECF5FC;
  border: 1px solid rgba(65, 139, 194, 150);
  border-radius: 4px;
  padding: 6px 11px;
  min-height: 24px;
  font-size: 10px;
  font-weight: 750;
}

QPushButton:hover {
  background: rgba(16, 43, 62, 245);
  border-color: #64B9F1;
  color: #FFFFFF;
}

QPushButton:pressed {
  background: rgba(27, 56, 73, 250);
}

QPushButton:disabled {
  color: #50616E;
  background: #090C0F;
  border-color: #202A31;
}

QPushButton#primaryAction {
  background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
              stop:0 rgba(16,45,67,245), stop:1 rgba(18,31,44,245));
  border: 1px solid #4AA4E2;
  color: #F6FBFF;
  font-weight: 850;
  letter-spacing: 0.5px;
}

QPushButton#secondary {
  background: rgba(7, 10, 14, 230);
  border-color: #3B4650;
  color: #AEBAC3;
}

QPushButton#danger, QPushButton#dangerAction {
  background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
              stop:0 #4C1019, stop:0.6 #651420, stop:1 #3A0D14);
  border: 1px solid #F13C55;
  color: #FFF2F4;
  font-weight: 900;
  letter-spacing: 0.6px;
}

QPushButton#danger:hover, QPushButton#dangerAction:hover {
  background: #7A1525;
  border-color: #FF667A;
}

QPushButton#recordButton {
  background: #F4A900;
  color: #0B0C0E;
  border: 1px solid #FFCB4D;
  font-weight: 900;
  letter-spacing: 0.5px;
}

QPushButton#recordButton[recording="true"] {
  background: #C51F38;
  color: #FFFFFF;
  border-color: #FF5368;
}

QPushButton#sourceModeButton {
  background: rgba(5, 9, 13, 235);
  border: 1px solid #334653;
  color: #8094A5;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: 1.1px;
}

QPushButton#sourceModeButton:checked {
  background: rgba(70, 14, 23, 235);
  border-color: #FF435B;
  color: #FFF2F4;
}

/* ----- Manual voltage rail ---------------------------------------------- */
QSlider#voltageReferenceSlider::groove:horizontal {
  height: 8px;
  background: #111922;
  border: 1px solid #263B4B;
  border-radius: 4px;
}

QSlider#voltageReferenceSlider::sub-page:horizontal {
  background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #5B1421, stop:1 #E6334D);
  border-radius: 4px;
}

QSlider#voltageReferenceSlider::handle:horizontal {
  width: 24px;
  margin: -9px 0;
  background: #E9EEF2;
  border: 2px solid #FF3D56;
  border-radius: 4px;
}

/* ----- Tabs -------------------------------------------------------------- */
QTabWidget#controlTabs::pane {
  border: none;
  background: transparent;
  top: -1px;
}

QTabBar::tab {
  background: rgba(3, 7, 11, 220);
  color: #66839A;
  border: 1px solid #172631;
  border-bottom: none;
  padding: 7px 13px;
  min-width: 100px;
  font-size: 9px;
  font-weight: 750;
  letter-spacing: 0.5px;
}

QTabBar::tab:hover {
  color: #B5D8F2;
  border-color: #315673;
}

QTabBar::tab:selected {
  color: #FF6477;
  background: rgba(42, 8, 14, 235);
  border-color: #A9253A;
}

/* ----- Charts ------------------------------------------------------------ */
QFrame#chartFrame {
  background: rgba(2, 5, 8, 230);
  border: 1px solid rgba(61, 127, 177, 65);
  border-radius: 3px;
}

QChartView#scopeChartView {
  background: transparent;
  border: none;
}

QToolButton#chartToolButton {
  background: rgba(4, 10, 15, 220);
  color: #6F8CA3;
  border: 1px solid rgba(61, 127, 177, 55);
  border-radius: 3px;
  padding: 2px 5px;
  font-size: 9px;
  font-weight: 750;
}

QToolButton#chartToolButton:hover {
  color: #E7F6FF;
  border-color: #4EA7E3;
}

QLabel#chartWindowLabel {
  color: #738CA0;
  font-family: "DejaVu Sans Mono", monospace;
  font-size: 9px;
}

/* ----- Top navigation / status ------------------------------------------ */
QToolBar#topbar {
  background: #05070A;
  border: none;
  border-bottom: 1px solid rgba(255, 60, 80, 80);
}

QStatusBar {
  background: #05070A;
  color: #71879A;
  border-top: 1px solid rgba(255, 60, 80, 50);
  font-family: "DejaVu Sans Mono", monospace;
  font-size: 9px;
}

QToolTip {
  background: #0A1118;
  color: #F5F8FB;
  border: 1px solid #E43A51;
  padding: 6px 8px;
  font-family: "DejaVu Sans Mono", monospace;
  font-size: 10px;
}

/* ----- Scrollbars -------------------------------------------------------- */
QScrollArea {
  border: none;
  background: transparent;
}

QScrollBar:vertical {
  width: 10px;
  background: #05080B;
  border: none;
}

QScrollBar::handle:vertical {
  background: #2E3B46;
  border: 1px solid #526A7C;
  border-radius: 4px;
  min-height: 24px;
}

QScrollBar::handle:vertical:hover {
  background: #702030;
  border-color: #E23B52;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
  background: none;
  height: 0px;
}

/* ==========================================================================
 * ARES 1.5 / automatic preview intelligence + system deck
 * ======================================================================== */
QLabel#previewConfigChip {
  color: #A9D9FF;
  font-family: "DejaVu Sans Mono", "Consolas", monospace;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.25px;
  background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
              stop:0 rgba(7,24,36,235), stop:1 rgba(10,13,20,235));
  border: 1px solid rgba(64,145,205,95);
  border-left: 2px solid #37A7EE;
  border-radius: 3px;
  padding: 4px 7px;
}

QFrame#systemHeroCard {
  background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
              stop:0 rgba(8,26,39,235), stop:0.65 rgba(5,10,15,240), stop:1 rgba(35,8,13,225));
  border: 1px solid rgba(62,142,202,85);
  border-bottom: 2px solid rgba(227,53,75,150);
  border-radius: 4px;
}

QLabel#systemHeroLabel {
  color: #6B879E;
  font-size: 8px;
  font-weight: 850;
  letter-spacing: 1.5px;
}

QLabel#systemHeroValue {
  color: #EEF8FF;
  font-family: "DejaVu Sans Mono", "Consolas", monospace;
  font-size: 16px;
  font-weight: 900;
}

QLabel#systemHeroValue[connected="true"] {
  color: #9EE0FF;
}

QLabel#systemHeroValue[active="true"] {
  color: #FF7486;
}

QFrame#systemTelemetryCard {
  background: rgba(4, 11, 17, 230);
  border: 1px solid rgba(56, 126, 178, 65);
  border-left: 2px solid rgba(65, 161, 226, 185);
  border-radius: 3px;
}

QLabel#systemTelemetryLabel {
  color: #66849C;
  font-size: 8px;
  font-weight: 850;
  letter-spacing: 1.2px;
}

QLabel#systemTelemetryValue {
  color: #F4F9FD;
  font-family: "DejaVu Sans Mono", "Consolas", monospace;
  font-size: 19px;
  font-weight: 900;
}

QLabel#systemTelemetryUnit {
  color: #B93A4C;
  font-family: "DejaVu Sans Mono", monospace;
  font-size: 9px;
  font-weight: 800;
}

QLabel#systemRuntimeValue {
  color: #DCEAF5;
  font-family: "DejaVu Sans Mono", "Consolas", monospace;
  font-size: 11px;
  font-weight: 750;
  background: rgba(5, 15, 23, 220);
  border: 1px solid rgba(60, 129, 178, 65);
  border-left: 2px solid rgba(220, 50, 72, 150);
  border-radius: 3px;
  padding: 5px 8px;
}

QLabel#systemPeakValue {
  color: #FFB1BB;
  font-family: "DejaVu Sans Mono", "Consolas", monospace;
  font-size: 13px;
  font-weight: 900;
  background: rgba(42, 8, 14, 210);
  border: 1px solid rgba(220, 53, 75, 100);
  border-radius: 3px;
  padding: 5px 8px;
}

QProgressBar#aresSafetyBar {
  min-height: 18px;
  max-height: 18px;
  background: #070C12;
  color: #EAF6FF;
  border: 1px solid rgba(64, 137, 190, 90);
  border-radius: 3px;
  text-align: center;
  font-family: "DejaVu Sans Mono", monospace;
  font-size: 9px;
  font-weight: 800;
}

QProgressBar#aresSafetyBar::chunk {
  background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
              stop:0 #1B6F9E, stop:0.65 #36A7E7, stop:0.85 #D43A50, stop:1 #FF445C);
  border-radius: 2px;
}

/* ========================================================================
 * ARES 1.6 / integrated reference-command workstation
 * ====================================================================== */
QTabWidget#referenceCommandTabs::pane {
  border: 1px solid rgba(54, 132, 184, 70);
  border-top: 1px solid rgba(225, 52, 73, 95);
  background: rgba(2, 6, 10, 205);
  top: -1px;
}

QTabWidget#referenceCommandTabs QTabBar::tab {
  min-width: 120px;
  padding: 8px 14px;
  background: rgba(3, 8, 13, 230);
  color: #6D8CA5;
  border: 1px solid rgba(45, 91, 124, 75);
  border-bottom: none;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: 0.8px;
}

QTabWidget#referenceCommandTabs QTabBar::tab:selected {
  color: #FFF1F4;
  background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
              stop:0 rgba(78,14,24,235), stop:1 rgba(32,8,14,235));
  border-color: #DF3A51;
  border-top: 2px solid #FF4E64;
}

QStackedWidget#manualInstrumentStack {
  background: rgba(2, 7, 11, 180);
  border: 1px solid rgba(54, 132, 184, 65);
  border-left: 2px solid rgba(45, 180, 225, 140);
  border-radius: 4px;
}
