* {
  font-family: "Inter", "Segoe UI", "DejaVu Sans", sans-serif;
  font-size: 13px;
}
QMainWindow, QWidget { background: #0A0E1A; color: #E2E8F0; }
QFrame#panel, QFrame#chartFrame, QFrame#valueTile {
  background: #141B2E; border: 2px solid #2D3748; border-radius: 12px; padding: 10px;
}
QLabel#title, QLabel#panelTitle, QLabel#chartTitle {
  font-size: 18px; font-weight: 700; color: #60A5FA; text-transform: uppercase; letter-spacing: 1px;
}
QLabel#valueTileLabel { font-weight: 600; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.5px; }
QLabel#valueTileValue { font-size: 28px; font-weight: 700; color: #60A5FA; }
QLabel#valueTileUnit, QLabel#subtitle { color: #94A3B8; }
QPushButton {
  background: #60A5FA; border: 2px solid #60A5FA; border-radius: 10px; padding: 9px 15px;
  color: #0A0E1A; font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px;
}
QPushButton:hover { border-color: #34D399; }
QPushButton#secondary { background: transparent; border-color: #2D3748; color: #E2E8F0; }
QPushButton#danger { background: #FF6B6B; border-color: #FF6B6B; color: #FFFFFF; font-weight: 800; }
QPushButton:disabled { background: #2D3748; border-color: #2D3748; color: #94A3B8; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit {
  background: #0F1420; border: 2px solid #2D3748; border-radius: 8px; padding: 7px 10px; color: #E2E8F0;
  selection-background-color: #60A5FA;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus { border-color: #60A5FA; }
QCheckBox { spacing: 7px; color: #E2E8F0; }
QGroupBox { border: 1px solid #2D3748; border-radius: 10px; margin-top: 12px; padding-top: 12px; font-weight: 700; color: #60A5FA; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; }
QToolTip { background: #141B2E; color: #E2E8F0; border: 1px solid #60A5FA; padding: 6px; }
QScrollArea { border: none; }
QScrollBar:vertical { background: #0F1420; width: 12px; border: none; }
QScrollBar::handle:vertical { background: #2D3748; border-radius: 6px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #60A5FA; }
QStatusBar { background: #141B2E; color: #E2E8F0; border-top: 1px solid #2D3748; }
QTabBar::tab { background: transparent; color: #94A3B8; padding: 10px 18px; font-weight: 600; border: none; }
QTabBar::tab:hover { color: #60A5FA; }
QTabBar::tab:selected { color: #60A5FA; border-bottom: 3px solid #60A5FA; }


/* Compact HMI widgets */
QFrame#subPanel { padding: 4px; }
QLabel#metricValue { font-size: 13px; font-weight: 700; padding: 2px 6px; }
QLabel#fieldLabel { font-weight: 600; }
QLabel#chartWindowLabel { padding: 0 3px; }
QToolButton#chartToolButton { min-width: 24px; min-height: 20px; }
QPushButton[recording="true"] { font-weight: 700; }
QChartView#scopeChartView { border: none; }

/* Data recorder state button */
QPushButton#recordButton {
  background: #F2C14E; color: #10141D; border: 1px solid #D6A526;
  font-weight: 750; padding: 6px 13px;
}
QPushButton#recordButton:hover { background: #F2C14E; border: 2px solid #D6A526; }
QPushButton#recordButton[recording="true"] {
  background: #DC4C5A; color: #FFFFFF; border-color: #DC4C5A;
}
